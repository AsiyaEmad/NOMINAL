# Application
NOMINAL_APP_ENV=development
NOMINAL_LOG_LEVEL=INFO
NOMINAL_DATABASE_URL=sqlite:///./nominal.db
# Comma-separated browser origins. Add a deployed dashboard origin explicitly.
NOMINAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
NOMINAL_DEFAULT_MODEL=economy-gpt-4.1-mini
# Estimated comparison baseline only; no call is made to this model for accounting.
NOMINAL_BASELINE_MODEL=frontier-o3
NOMINAL_BENCHMARK_FRONTIER_MODEL=frontier-o3
NOMINAL_BENCHMARK_ECONOMY_MODEL=economy-gpt-4.1-mini
NOMINAL_BENCHMARK_DATASET_PATH=benchmarks/dataset.json
# The MVP profiler is deterministic and makes no LLM calls. This remains false by default.
NOMINAL_PROFILER_LLM_ENABLED=false
# Disabled by default; a judge callback is only injected in benchmark/demo mode.
NOMINAL_QUALITY_JUDGE_ENABLED=false
NOMINAL_MAX_QUALITY_ESCALATIONS=1
NOMINAL_MAX_PROVIDER_FAILOVERS=1

# Model catalog. Relative paths are resolved from the current working directory.
NOMINAL_MODEL_CATALOG_PATH=backend/config/models.yaml

# Provider connections are JSON. Keep this file private if you add a real key;
# the example value is deliberately empty and no API key is ever logged.
# OpenAI-compatible base URLs include their API version, e.g. https://api.openai.com/v1.
NOMINAL_PROVIDER_CONFIGS={"openai":{"kind":"openai_compatible","base_url":"https://api.openai.com/v1","api_key":"","timeout_seconds":30},"ollama":{"kind":"ollama","base_url":"http://localhost:11434","timeout_seconds":60}}
